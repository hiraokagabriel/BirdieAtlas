# BirdieAtlas Web — variáveis de ambiente. Copie para .env.local.

# URL da API (padrão: http://localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Endereço público do site. Vira a base dos links absolutos de og:image e twitter:image
# (cartões de compartilhamento do WhatsApp, Instagram e X). Padrão: http://localhost:3000.
# Em produção, use o domínio real, sem barra final (ex.: https://birdieatlas.exemplo.com.br).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
