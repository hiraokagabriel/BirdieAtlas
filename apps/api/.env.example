# ---------------------------------------------------------------------------
# BirdieAtlas API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/birdie_atlas

# Porta da API (padrão: 3001)
PORT=3001

# Tenant usado em todas as operações administrativas até o Clerk trazer organizações.
# Opcional quando há exatamente um tenant cadastrado.
DEFAULT_TENANT_SLUG=fpb-sp

# ---------------------------------------------------------------------------
# Modo Admin de Desenvolvimento
#
# Define se as rotas protegidas estão liberadas durante o desenvolvimento.
# NUNCA sete como true em produção.
#
# true  → todas as rotas protegidas ficam acessíveis (sem autenticação)
# false → rotas protegidas retornam 403
#
# Também pode ser alternado pelo botão na interface ou via:
#   PATCH http://localhost:3001/dev/admin-mode  { "enabled": true }
# ---------------------------------------------------------------------------
DEV_ADMIN_MODE=true

# ---------------------------------------------------------------------------
# PIN de admin para a rede local
#
# Com ADMIN_PIN definido (mínimo de 8 caracteres), só quem digitar o PIN no botão
# "Entrar como admin" consegue escrever. DEV_ADMIN_MODE passa a ser ignorado e
# PATCH /dev/admin-mode é recusado. Use sempre que o Wi-Fi do torneio for aberto ao público.
# Vazio ou ausente: modo de desenvolvimento acima.
# Em produção (NODE_ENV=production) é obrigatório, com pelo menos 16 caracteres.
# ---------------------------------------------------------------------------
# ADMIN_PIN=

# ---------------------------------------------------------------------------
# Produção (internet)
#
# NODE_ENV=production liga as checagens: a API não sobe com DEV_ADMIN_MODE=true,
# sem ADMIN_PIN de 16+ caracteres ou sem CORS_ORIGINS. Liga também o limite de requisições.
# CORS_ORIGINS: origens do site, separadas por vírgula; * vale por um trecho de subdomínio.
# TRUST_PROXY: quantos proxies há na frente da API (Render: medir no deploy). Padrão 0.
# ---------------------------------------------------------------------------
# NODE_ENV=production
# CORS_ORIGINS=https://birdieatlas.vercel.app,https://birdieatlas-*-<time>.vercel.app
# Nunca use https://*.vercel.app: liberaria qualquer projeto de qualquer conta.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Clerk Auth (Phase 0 — ainda não integrado)
# ---------------------------------------------------------------------------
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
