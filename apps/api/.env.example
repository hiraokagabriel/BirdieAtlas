# ---------------------------------------------------------------------------
# BirdieAtlas API — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/birdie_atlas

# Porta da API (padrão: 3001)
PORT=3001

# ---------------------------------------------------------------------------
# Modo Admin de Desenvolvimento
#
# Define se as rotas protegidas estão liberadas durante o desenvolvimento.
# NUNCA sete como true em produção.
#
# true  → todas as rotas protegidas ficam acessíveis (sem autenticação)
# false → rotas protegidas retornam 403
#
# Também pode ser alternado pelo botão na interface ou via:
#   PATCH http://localhost:3001/dev/admin-mode  { "enabled": true }
# ---------------------------------------------------------------------------
DEV_ADMIN_MODE=true

# ---------------------------------------------------------------------------
# Clerk Auth (Phase 0 — ainda não integrado)
# ---------------------------------------------------------------------------
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
