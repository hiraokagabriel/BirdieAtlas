{
  "name": "@birdie-atlas/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@birdie-atlas/validators": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.41.0",
    "fastify": "^5.8.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.1",
    "@birdie-atlas/types": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.14",
    "drizzle-kit": "0.30.6",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
