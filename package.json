{
  "name": "BirdieAtlas",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "e2e": "pnpm --filter @birdie-atlas/validators build && pnpm --filter @birdie-atlas/e2e e2e",
    "e2e:install": "pnpm --filter @birdie-atlas/e2e exec playwright install chromium"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "csstype": "3.1.3"
    }
  }
}
